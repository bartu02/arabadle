# Supabase — panelde Settings > API Keys.
# Bu dosyayi .env.local olarak kopyala ve doldur. .env.local git'e girmez.

NEXT_PUBLIC_SUPABASE_URL=

# Sadece sunucu tarafinda kullanilir, tarayiciya HIC inmez.
# RLS'i tamamen atlar: sizarsa butun veritabani okunur ve yazilir.
#
# - Adi asla NEXT_PUBLIC_ ile baslamamali.
# - Sohbete, ekran goruntusune, loga yapistirilmamali.
# - Sizdiginda tek dogru hamle panelden yenilemek; eskisi aninda gecersiz olur.
SUPABASE_SECRET_KEY=

# Istege bagli. Hiz siniri tablosunda IP'ler duz degil, tuzlu SHA-256 ozeti
# olarak tutuluyor; tuz budur. Bos birakilirsa secret key'den turetilir.
IP_HASH_SALT=

# Vercel'de ZORUNLU: paylasim linkleri ve OG etiketleri buna bagli.
# Ornek: https://alsatyak.example.com
NEXT_PUBLIC_SITE_URL=

# NOT: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY artik kullanilmiyor.
# Tarayici Supabase'e hic gitmiyor, butun sorgular sunucudan geciyor.
# Vercel'de tanimlama.

# Vercel DISINDA bir yere kurulursa ve onunde x-real-ip / x-forwarded-for
# basliklarini EZEN bir proxy varsa 1 yap. Proxy yoksa asla 1 yapma:
# istemci kendi IP basligini yazip hiz sinirini atlatir.
# Vercel'de tanimlama — orada yalnizca platformun kendi basligi okunur.
TRUST_PROXY_HEADERS=
